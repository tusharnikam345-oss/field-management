# ==============================================================================
# FIELD PLUS — Environment Configuration Template
# Copy this file to '.env' and fill in your local settings
# ==============================================================================

# Flask Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace_with_a_secure_random_string_for_production

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=field_plus_db
